# Copy to .env on the iMac. Never commit .env.
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=n8n

# Keep the existing value from the running n8n instance. Changing it makes
# existing encrypted credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_KEEP_EXISTING_VALUE
N8N_HOST=orange-imac.tail14202a.ts.net
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://orange-imac.tail14202a.ts.net/
WEBHOOK_URL=https://orange-imac.tail14202a.ts.net/
GENERIC_TIMEZONE=Asia/Seoul
ATEMOYA_TELEGRAM_CHAT_ID=CHANGE_ME
