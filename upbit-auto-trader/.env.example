# Keep empty until a read-only key is ready and this server IP is allowlisted.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_BASE_URL=https://api.upbit.com

# Binance USD-M Futures. Leave disabled until the key and trusted IP are ready.
# The neural collector is read-only and has no order or withdrawal implementation.
BINANCE_FUTURES_ENABLED=false
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

MARKET=KRW-BTC
INTERVAL=minute5
CANDLE_COUNT=120

MA_SHORT=5
MA_MID=20
MA_LONG=60

RSI_PERIOD=14
RSI_BUY_LIMIT=70

BUY_AMOUNT_RATIO=0.30
MAX_BUY_COUNT=3
ADD_BUY_DROP_RATES=0.02,0.04

TAKE_PROFIT_RATE_1=0.03
TAKE_PROFIT_SELL_RATIO_1=0.50
TAKE_PROFIT_RATE_2=0.05

STOP_LOSS_RATE=0.03
TRAILING_STOP_RATE=0.02

MIN_ORDER_KRW=5000
MAX_DAILY_LOSS=0.05
MAX_POSITION_KRW_RATIO=0.90
PAPER_INITIAL_KRW=1000000

LOOP_INTERVAL=10

# Use 8766 on the Atemoya iMac because 8765 is reserved for the existing
# operations dashboard.
NEURAL_PORT=8766

DRY_RUN=true
ENABLE_REAL_TRADE=false

# 주요 단계 알림을 콘솔, 대시보드 상태, 텔레그램으로 보냅니다.
# HOLD 신호까지 매 주기 텔레그램으로 받고 싶을 때만 true로 변경하세요.
NOTIFY_STEPS=true
NOTIFY_HOLD_SIGNALS=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
