        "name": "점검 자료 합치기",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3,
        "position": [-120, 80]
      },
      {
        "parameters": {
          "jsCode": "const pageUrl='https://orange3718.github.io/Banana/offers/cutdang-apple-vinegar.html'; const expectedGa4='G-LKX74KWHLM'; const inputs=$input.all().map(i=>i.json); const page=inputs.find(i=>String(i.data??i.body??'').includes('쿠팡 파트너스 활동의 일환'))||{}; const ga4=inputs.find(i=>String(i.data??i.body??'').includes('gaMeasurementId'))||{}; const body=String(page.body??page.data??''); const configBody=String(ga4.body??ga4.data??''); const status=Number(page.statusCode??0); const disclosure=body.includes('쿠팡 파트너스 활동의 일환'); const link=/https:\\/\\/link\\.coupang\\.com\\/a\\/[A-Za-z0-9]+/.test(body)&&body.includes('rel=\"sponsored nofollow\"'); const reachable=status>=200&&status<400&&body.length>200; const ga4ConfigValid=configBody.includes(expectedGa4); const healthy=reachable&&disclosure&&link&&ga4ConfigValid; return [{json:{asset_key:'cutdang-apple-vinegar',page_url:pageUrl,http_status:status,page_reachable:reachable,disclosure_present:disclosure,affiliate_link_present:link,ga4_config_valid:ga4ConfigValid,healthy,details:{body_length:body.length,ga4_expected:expectedGa4,checked_by:'n8n-public-health-check'},checked_at:new Date().toISOString()}}];"
        },
        "id": "affiliate-validate",
        "name": "고지와 링크 검증",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [100, 80]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO affiliate_health_checks(asset_key,page_url,http_status,page_reachable,disclosure_present,affiliate_link_present,ga4_config_valid,healthy,details) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9::jsonb) RETURNING checked_at,asset_key,page_url,http_status,page_reachable,disclosure_present,affiliate_link_present,ga4_config_valid,healthy;",
          "options": {
            "queryReplacement": "={{ [$json.asset_key,$json.page_url,$json.http_status,$json.page_reachable,$json.disclosure_present,$json.affiliate_link_present,$json.ga4_config_valid,$json.healthy,JSON.stringify($json.details)] }}"
          }
        },
        "id": "affiliate-store",
        "name": "PostgreSQL 상태 기록",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
