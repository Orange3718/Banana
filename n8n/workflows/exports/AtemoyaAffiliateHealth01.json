          "text": "={{ ($json.healthy ? '✅' : '🚨') + ' Atemoya 제휴 페이지 일일 점검\\n' + new Date($json.checked_at).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'}) + '\\n\\n페이지: ' + ($json.page_reachable?'정상':'오류') + '\\n제휴 고지: ' + ($json.disclosure_present?'정상':'누락') + '\\n쿠팡 버튼: ' + ($json.affiliate_link_present?'정상':'누락') + '\\nGA4 측정: ' + ($json.ga4_config_valid?'정상':'오류') + '\\nHTTP: ' + $json.http_status + '\\n\\n' + ($json.healthy?'조치 필요 없음':'자동 기록 완료 · 페이지 수정 필요') }}",
          "additionalFields": {
            "disable_web_page_preview": true
          }
        },
