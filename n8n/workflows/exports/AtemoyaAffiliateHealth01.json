[
  {
    "id": "AtemoyaAffiliateHealth01",
    "name": "Atemoya 제휴 페이지 일일 상태 점검",
    "active": true,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "30 9 * * *"
              }
            ]
          }
        },
        "id": "affiliate-schedule",
        "name": "매일 오전 9시 30분",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [-600, 0]
      },
      {
        "parameters": {},
        "id": "affiliate-manual",
        "name": "수동 점검",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [-600, 180]
      },
      {
        "parameters": {
          "url": "https://orange3718.github.io/Banana/offers/cutdang-apple-vinegar.html",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "User-Agent",
                "value": "Atemoya-Affiliate-Health/1.0"
              }
            ]
          },
          "options": {
            "timeout": 30000,
            "response": {
              "response": {
                "fullResponse": true,
                "neverError": true,
                "responseFormat": "text"
              }
            }
          }
        },
        "id": "affiliate-fetch",
        "name": "제휴 페이지 가져오기",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [-340, 80]
      },
      {
        "parameters": {
          "jsCode": "const pageUrl='https://orange3718.github.io/Banana/offers/cutdang-apple-vinegar.html'; const body=String($json.body ?? $json.data ?? ''); const status=Number($json.statusCode ?? 200); const disclosure=body.includes('쿠팡 파트너스 활동의 일환'); const link=/https:\\/\\/link\\.coupang\\.com\\/a\\/[A-Za-z0-9]+/.test(body) && body.includes('rel=\"sponsored nofollow\"'); const reachable=status>=200&&status<400&&body.length>200; const healthy=reachable&&disclosure&&link; return [{json:{asset_key:'cutdang-apple-vinegar',page_url:pageUrl,http_status:status,page_reachable:reachable,disclosure_present:disclosure,affiliate_link_present:link,healthy,details:{body_length:body.length,checked_by:'n8n-public-health-check'},checked_at:new Date().toISOString()}}];"
        },
        "id": "affiliate-validate",
        "name": "고지와 링크 검증",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [-80, 80]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO affiliate_health_checks(asset_key,page_url,http_status,page_reachable,disclosure_present,affiliate_link_present,healthy,details) VALUES($1,$2,$3,$4,$5,$6,$7,$8::jsonb) RETURNING checked_at,asset_key,page_url,http_status,page_reachable,disclosure_present,affiliate_link_present,healthy;",
          "options": {
            "queryReplacement": "={{ [$json.asset_key,$json.page_url,$json.http_status,$json.page_reachable,$json.disclosure_present,$json.affiliate_link_present,$json.healthy,JSON.stringify($json.details)] }}"
          }
        },
        "id": "affiliate-store",
        "name": "PostgreSQL 상태 기록",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [180, 80],
        "credentials": {
          "postgres": {
            "id": "AtemoyaPostgresMemory01",
            "name": "Atemoya PostgreSQL Memory"
          }
        }
      },
      {
        "parameters": {
          "chatId": "={{ $vars.ATEMOYA_TELEGRAM_CHAT_ID }}",
          "text": "={{ ($json.healthy ? '✅' : '🚨') + ' Atemoya 제휴 페이지 일일 점검\\n' + new Date($json.checked_at).toLocaleString('ko-KR',{timeZone:'Asia/Seoul'}) + '\\n\\n페이지: ' + ($json.page_reachable?'정상':'오류') + '\\n제휴 고지: ' + ($json.disclosure_present?'정상':'누락') + '\\n쿠팡 버튼: ' + ($json.affiliate_link_present?'정상':'누락') + '\\nHTTP: ' + $json.http_status + '\\n\\n' + ($json.healthy?'조치 필요 없음':'자동 기록 완료 · 페이지 수정 필요') }}",
          "additionalFields": {
            "disable_web_page_preview": true
          }
        },
        "id": "affiliate-telegram",
        "name": "Telegram 일일 상태 보고",
        "type": "n8n-nodes-base.telegram",
        "typeVersion": 1.2,
        "position": [440, 80],
        "credentials": {
          "telegramApi": {
            "id": "6WaLMIqUth2LtuDZ",
            "name": "Telegram account"
          }
        }
      }
    ],
    "connections": {
      "매일 오전 9시 30분": {"main": [[{"node": "제휴 페이지 가져오기", "type": "main", "index": 0}]]},
      "수동 점검": {"main": [[{"node": "제휴 페이지 가져오기", "type": "main", "index": 0}]]},
      "제휴 페이지 가져오기": {"main": [[{"node": "고지와 링크 검증", "type": "main", "index": 0}]]},
      "고지와 링크 검증": {"main": [[{"node": "PostgreSQL 상태 기록", "type": "main", "index": 0}]]},
      "PostgreSQL 상태 기록": {"main": [[{"node": "Telegram 일일 상태 보고", "type": "main", "index": 0}]]}
    },
    "settings": {
      "timezone": "Asia/Seoul",
      "executionOrder": "v1",
      "errorWorkflow": "AtemoyaErrorHandler01"
    },
    "tags": []
  }
]
